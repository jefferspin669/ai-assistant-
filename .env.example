# Optional in development. Required to unlock /app when NODE_ENV=production.
# Generate a long random value, e.g.: openssl rand -base64 32
ATLAS_APP_PASSWORD=

# Optional Basic Auth username (default: atlas)
# ATLAS_APP_USER=atlas

# ─── Atlas Brain (Phase 0) ───────────────────────────────────────────────────
# OpenAI-compatible Chat Completions API. Works with OpenAI, OpenRouter, Groq, Ollama, etc.
# When unset, Command Center uses the keyword simulation Brain.
ATLAS_LLM_API_KEY=
# ATLAS_LLM_BASE_URL=https://api.openai.com/v1
# ATLAS_LLM_MODEL=gpt-4o-mini
# Ollama example:
# ATLAS_LLM_BASE_URL=http://127.0.0.1:11434/v1
# ATLAS_LLM_MODEL=llama3.2
# ATLAS_LLM_API_KEY=ollama

# ─── Phase 1+ commercial stack (not wired yet) ───────────────────────────────
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/atlas
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
