# Copy to .env.local. Never commit secrets.
# Production: put these in the host (Vercel / Fly / AWS Secrets Manager), never in client JS.
# Only NEXT_PUBLIC_* values are exposed to the browser — keep those to anon keys and public URLs.

# Optional in development. Required (16+ chars) when NODE_ENV=production.
# Generate a long random value, e.g.: openssl rand -base64 32
ATLAS_APP_PASSWORD=

# Optional Basic Auth username (default: atlas)
# ATLAS_APP_USER=atlas

# Public app URL (OAuth redirects, Stripe return URLs, TwiML action URLs)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# ATLAS_BUSINESS_NAME=Desert Air HVAC

# ─── Atlas Brain (official OpenAI SDK) ───────────────────────────────────────
ATLAS_LLM_API_KEY=
# OPENAI_API_KEY=                  # alias if you prefer the standard name
# ATLAS_LLM_BASE_URL=https://api.openai.com/v1
# ATLAS_LLM_MODEL=gpt-4o-mini

# ─── PostgreSQL / Drizzle (dual-write from .data JSON) ───────────────────────
# Local Docker: docker compose up -d postgres redis
# Hosted: paste the Supabase connection string (Database settings → URI).
# DATABASE_URL=postgres://atlas:atlas@localhost:5432/atlas
# Then: npm run db:migrate

# ─── Redis + BullMQ workers ──────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379
# Run: npm run worker

# ─── Supabase (hosted Postgres, Auth, Realtime, Storage) ─────────────────────
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=     # browser / Auth — safe to be public
# SUPABASE_SERVICE_ROLE_KEY=         # server only — never NEXT_PUBLIC_
# SUPABASE_ANON_KEY=                 # optional server alias for storage uploads
# SUPABASE_STORAGE_BUCKET=atlas
# Apply Drizzle SQL for JSON dual-write, or: psql "$DATABASE_URL" -f supabase/schema.sql

# ─── Twilio receptionist + SMS ───────────────────────────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=+1...
# TWILIO_ESCALATE_NUMBER=+1...   # owner phone for emergencies
# Voice webhook: POST /api/webhooks/twilio/voice
# Status callback: POST /api/webhooks/twilio/voice/status
# SMS webhook: POST /api/webhooks/twilio/sms

# ─── Resend email ────────────────────────────────────────────────────────────
# RESEND_API_KEY=
# RESEND_FROM=Atlas <atlas@yourdomain.com>

# ─── Google Calendar ─────────────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Redirect: {APP_URL}/api/calendar/oauth/google/callback

# ─── Microsoft Calendar (Graph) ──────────────────────────────────────────────
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# Redirect: {APP_URL}/api/calendar/oauth/microsoft/callback

# ─── Stripe subscriptions ────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_BUSINESS=price_...
# STRIPE_CUSTOMER_ID=cus_...   # optional for billing portal demos
# Webhook: POST /api/webhooks/stripe

# ─── Observability ───────────────────────────────────────────────────────────
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# ─── S3-compatible object storage (reserved; Supabase Storage is used first) ─
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=auto

# ─── Autonomy background tick (Vercel Cron → GET /api/autonomy/tick) ────────
# CRON_SECRET=
# Vercel sends Authorization: Bearer $CRON_SECRET. Without it, tick requires an owner session.
